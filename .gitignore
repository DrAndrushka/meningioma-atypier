# -----------------------------------------------------------------------------
__pycache__/
*.py[cod]
*$py.class
.Python

.venv/
venv/
env/

*.egg-info/
.eggs/
dist/
build/

.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
htmlcov/

